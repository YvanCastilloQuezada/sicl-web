import { afterEach, beforeEach, describe, expect, it } from "vitest";
import { mkdtempSync, readFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import Database from "better-sqlite3";

import { createSqliteArkiCommandSessionRepository } from "./db.sqlite.sessions";

describe("SQLite ARKI command sessions repository", () => {
  let directory: string;
  let databasePath: string;

  const makeSession = (
    overrides: Record<string, unknown> = {},
  ) => {
    const now = Date.now();

    return {
      ownerId: 10,
      projectId: "PROJECT-1",
      sessionId: "SESSION-1",
      commandName: "ARKI_TEST",
      parameters: "{}",
      previewResult: "{}",
      tutorialStep: 0,
      exerciseScore: null,
      exerciseState: "IN_PROGRESS" as const,
      lastAction: "AUTOSAVE" as const,
      createdAt: now,
      updatedAt: now,
      ...overrides,
    };
  };

  beforeEach(() => {
    directory = mkdtempSync(join(tmpdir(), "sicl-sessions-"));
    databasePath = join(directory, "sessions.sqlite");

    const sqlite = new Database(databasePath);
    sqlite.exec(
      readFileSync(
        resolve(process.cwd(), "drizzle/sqlite/migrations/0000_initial.sql"),
        "utf8",
      ),
    );
    sqlite.close();
  });

  afterEach(() => {
    rmSync(directory, { recursive: true, force: true });
  });

  it("inserts and retrieves a session by owner and sessionId", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await repo.save(makeSession());

      const result = await repo.get(10, "SESSION-1");

      expect(result).toBeDefined();
      expect(result?.ownerId).toBe(10);
      expect(result?.sessionId).toBe("SESSION-1");
      expect(result?.commandName).toBe("ARKI_TEST");
    } finally {
      repo.close();
    }
  });

  it("does not expose a session to another owner", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await repo.save(makeSession());

      expect(await repo.get(99, "SESSION-1")).toBeUndefined();
    } finally {
      repo.close();
    }
  });

  it("lists sessions only for the requested owner and project", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await repo.save(makeSession({
        sessionId: "OLDER",
        updatedAt: 100,
      }));
      await repo.save(makeSession({
        sessionId: "NEWER",
        updatedAt: 200,
      }));
      await repo.save(makeSession({
        ownerId: 20,
        sessionId: "OTHER-OWNER",
        updatedAt: 300,
      }));
      await repo.save(makeSession({
        projectId: "OTHER-PROJECT",
        sessionId: "OTHER-PROJECT-SESSION",
        updatedAt: 400,
      }));

      const results = await repo.listByProject(10, "PROJECT-1");

      expect(results.map((item) => item.sessionId)).toEqual([
        "NEWER",
        "OLDER",
      ]);
      expect(results.every((item) => item.ownerId === 10)).toBe(true);
      expect(results.every((item) => item.projectId === "PROJECT-1")).toBe(true);
    } finally {
      repo.close();
    }
  });

  it("updates an existing session without creating a duplicate", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await repo.save(makeSession());

      await repo.save(makeSession({
        commandName: "ARKI_UPDATED",
        parameters: '{"updated":true}',
        lastAction: "MANUAL_SAVE",
      }));

      const result = await repo.get(10, "SESSION-1");
      const rows = await repo.listByProject(10, "PROJECT-1");

      expect(result?.commandName).toBe("ARKI_UPDATED");
      expect(result?.parameters).toBe('{"updated":true}');
      expect(result?.lastAction).toBe("MANUAL_SAVE");
      expect(rows).toHaveLength(1);
    } finally {
      repo.close();
    }
  });

  it("rejects a duplicate sessionId belonging to another owner", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await repo.save(makeSession());

      await expect(
        repo.save(makeSession({ ownerId: 20 })),
      ).rejects.toThrow();

      expect(await repo.get(10, "SESSION-1")).toBeDefined();
      expect(await repo.get(20, "SESSION-1")).toBeUndefined();
    } finally {
      repo.close();
    }
  });

  it("persists a session after closing and reopening SQLite", async () => {
    const first = createSqliteArkiCommandSessionRepository(databasePath);

    await first.save(makeSession({
      commandName: "PERSISTED",
    }));
    first.close();

    const second = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      const result = await second.get(10, "SESSION-1");

      expect(result).toBeDefined();
      expect(result?.commandName).toBe("PERSISTED");
    } finally {
      second.close();
    }
  });

  it("rejects invalid exerciseState through SQLite CHECK", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await expect(
        repo.save(makeSession({
          exerciseState: "INVALID",
        })),
      ).rejects.toThrow();
    } finally {
      repo.close();
    }
  });

  it("rejects invalid lastAction through SQLite CHECK", async () => {
    const repo = createSqliteArkiCommandSessionRepository(databasePath);

    try {
      await expect(
        repo.save(makeSession({
          lastAction: "INVALID",
        })),
      ).rejects.toThrow();
    } finally {
      repo.close();
    }
  });
});
