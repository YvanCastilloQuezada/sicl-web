        speak(assistantMsg); // <--- ESTO ACTIVA LA VOZ
        
    
    const formData = new FormData();
    formData.append("file", file);
    formData.append("project_id", "PRO-001");
    
    try {
      const res = await fetch("/api/v1/files/upload", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();
      
      if (res.ok) {
        setMessages(prev => [...prev, { role: "assistant", text: "✅ " + data.message + "\n\n💡 Sugerencia: Escribe 'Analiza este archivo' o 'Genera una propuesta basada en esto'." }]);
      } else {
        setMessages(prev => [...prev, { role: "assistant", text: "❌ Error al subir: " + (data.detail || "Desconocido") }]);
      }
    } catch (err: any) {
      setMessages(prev => [...prev, { role: "assistant", text: "❌ Error de conexión: " + (err.message || "Verifica que el servicio esté activo") }]);
    } finally {
      setUploading(false);
    }
  };

  const handleNormativaSearch = async () => {
    if (!input.trim()) {
      setMessages(prev => [...prev, { role: "assistant", text: "⚠️ Escribe qué normativa necesitas buscar. Ej: 'Busca normativa sobre estacionamientos' o 'RNE accesibilidad'." }]);
      return;
    }
    
    setSearchingNormativa(true);
    setShowPlusMenu(false);
    setMessages(prev => [...prev, { role: "assistant", text: `🔍 Buscando normativa sobre: "\${input}"...` }]);
    
    try {
      const res = await fetch("/api/v1/normativa/search", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query: input,
          limit: 5
        })
      });
      
      const results = await res.json();
      
      if (res.ok && results.length > 0) {
        let formattedResults = `✅ Encontré \${results.length} artículos relevantes:

`;
        
        results.forEach((art: any, i: number) => {
          formattedResults += `📌 **\${art.norma} - \${art.articulo}**\n`;
          formattedResults += `📋 \${art.titulo}\n`;
          formattedResults += `📝 \${art.contenido}\n`;
          formattedResults += ` Relevancia: \${art.relevancia}%\n`;
          formattedResults += `---\n\n`;
        });
        
        formattedResults += `💡 *Escribe "Aplica esto a mi proyecto" para que ARKI revise el cumplimiento.*`;
        
        setMessages(prev => [...prev, { role: "assistant", text: formattedResults }]);
      } else if (res.ok) {
        setMessages(prev => [...prev, { 
          role: "assistant", 
          text: `⚠️ No encontré artículos exactos sobre "\${input}".\n\n💡 Prueba con:\n- "RNE estacionamientos"\n- "Accesibilidad universal"\n- "Áreas mínimas hospitales"\n- "OECE licitaciones"` 
        }]);
      } else {
        setMessages(prev => [...prev, { role: "assistant", text: `❌ Error: \${results.detail || 'Servicio de normativa no disponible'}` }]);
      }
    } catch (err) {
      setMessages(prev => [...prev, { role: "assistant", text: "❌ Error de conexión con ARKI Core. Verifica que el servicio esté activo." }]);
    } finally {
      setSearchingNormativa(false);
      setInput("");
    }
  };

  const handleVisionAnalysis = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    
    setAnalyzingVision(true);
    setShowPlusMenu(false);
    setMessages(prev => [...prev, { role: "assistant", text: `👁️ Analizando imagen: \`\${file.name}\`...` }]);
    
    const formData = new FormData();
    formData.append("file", file);
    formData.append("prompt", "Analiza esta imagen arquitectónica. Describe: tipo de edificación, estado, elementos visibles, problemas potenciales y recomendaciones.");
    
    try {
      const res = await fetch("/api/v1/vision/analyze", {
        method: "POST",
        body: formData,
      });
      
      const data = await res.json();
      
      if (res.ok) {
        setMessages(prev => [...prev, { 
          role: "assistant", 
          text: `✅ **Análisis de Visión Artificial:**

\${data.analysis}

💡 *Escribe "Genera una propuesta basada en este análisis" para continuar.*` 
        }]);
      } else {
        setMessages(prev => [...prev, { role: "assistant", text: `❌ Error: \${data.detail || 'Análisis fallido'}` }]);
      }
    } catch (err) {
      setMessages(prev => [...prev, { role: "assistant", text: "❌ Error de conexión con ARKI Vision Engine." }]);
    } finally {
      setAnalyzingVision(false);
    }
  };

  
  // Efecto para que ARKI hable cuando hay un mensaje nuevo del asistente
  useEffect(() => {
    if (messages.length > 0) {
      const lastMessage = messages[messages.length - 1];
      if (lastMessage.role === "assistant") {
        // Limpiamos el texto de markdown o etiquetas para que suene natural
        const cleanText = lastMessage.text.replace(/[*#_]/g, "").replace(/\n/g, " ");
        speak(cleanText);
      }
    }
  }, [messages, speak]);

    const handleSend = async () => {
    if (!input.trim()) return;
    const userMsg = input;
    setMessages(prev => [...prev, { role: "user", text: userMsg }]);
    setInput("");
    setIsGenerating(true);

    try {
      setMessages(prev => [...prev, { role: "assistant", text: "🧠 Consultando al copiloto (RTX A400)..." }]);
      
      const copilotRes = await fetch('/api/core/v1/copilot/translate', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${(window as any).SICL_CORE_SERVICE_TOKEN || ''}`
        },
        body: JSON.stringify({ text: userMsg })
      });
      
      const copilotJson = await copilotRes.json();
      const intent = copilotJson?.data?.intent || copilotJson?.intent;
      
      if (intent) {
        const action = intent.action || "CHAT";
        const explanation = intent.explanation || "Sin explicación.";
        
        console.log("[Copilot] Action:", action, "| Params:", intent.parameters);
        
        if (action === "SEARCH_NORMATIVE") {
          setMessages(prev => [...prev, { role: "assistant", text: `📚 ${explanation}\n\n🔍 Buscando: "${intent.query || userMsg}"` }]);
          setActiveModal('norms');
          
        } else if (action === "DESIGN") {
          const p = intent.parameters || {};
          
          // 1. Actualizar el panel de la izquierda
          if (p.area_m2) setAreaTerreno(p.area_m2);
          if (p.pisos) setPisosTerreno(p.pisos);
          if (p.ciudad) setCiudadTerreno(p.ciudad);
          if (p.estilo) setEstiloTerreno(p.estilo);
          
          // 2. Mostrar resumen en el chat
          const resumen = Object.entries(p)
            .filter(([_, v]) => v !== null && v !== undefined)
            .map(([k, v]) => `• ${k}: ${v}`)
            .join("\n");
          
          setMessages(prev => [...prev, { 
            role: "assistant", 
            text: `✅ ${explanation}\n\n📋 Parámetros extraídos:\n${resumen}\n\n🎯 Generando 9 propuestas...` 
          }]);
          
          // 3. GENERAR LAS 9 PROPUESTAS (forzado)
          await generateProposalsFromParams(p);
          
        } else {
          setMessages(prev => [...prev, { role: "assistant", text: explanation }]);
        }
        
        if (typeof speak === 'function') speak(explanation);
        
      } else {
        setMessages(prev => [...prev, { role: "assistant", text: "❌ El copiloto no devolvió una respuesta válida." }]);
      }
      
    } catch (error: any) {
      console.error("[Copilot] Error:", error);
      setMessages(prev => [...prev, { role: "assistant", text: `❌ Error: ${error.message}` }]);
    } finally {
      setIsGenerating(false);
    }
  };


  const generateProposalsFromParams = async (params: any) => {
    // 1. Intentar llamar al backend
    let buildingData = null;
    try {
      const geoRes = await fetch('/api/trpc/parametricRuntime.generateDynamicBuilding?batch=1&input=' + encodeURIComponent(JSON.stringify({
        "0": { "json": { 
          "familyId": params.tipo || "generic", 
          "variantId": "default", 
          "params": {
            "area": params.area_m2 || 1000,
            "floors": params.pisos || 3,
            "capacity": params.capacidad || 100
          }
        } }
      }))).catch(() => null);
      
      if (geoRes && geoRes.ok) {
        const geoData = await geoRes.json();
        buildingData = geoData[0]?.result?.data?.json;
      }
    } catch (e) {
      console.warn("[ARKI] Backend no disponible, generando localmente:", e);
    }

    // 2. Generar SIEMPRE las 9 propuestas (con o sin backend)
    const strategies = [
      "Monobloque Compacto", "Pabellonado Lineal", "Patio Central",
      "Forma en H", "Forma en U", "Torre Única",
      "Zócalo + Torre", "Claustro", "Orgánico Curvo"
    ];

    const proposals = strategies.map((strategy, i) => ({
      id: `prop-${Date.now()}-${i}`,
      title: `Alternativa ${i + 1}`,
      strategy: strategy,
      metrics: {
        area: params.area_m2 || (15000 + i * 500),
        floors: params.pisos || (Math.floor(Math.random() * 4) + 3)
      },
      // Si el backend falló, usamos geometría sintética
      building: buildingData || {
        geometry3d: { floors: params.pisos || 3, heightM: (params.pisos || 3) * 3.5, massing: "COURTYARD_MASS" },
        geometry2d: { widthM: 80, depthM: 60, footprintM2: 4800, courtyardM2: 800 }
      }
    }));

    setPartis(proposals);
    console.log(`[ARKI] ${proposals.length} propuestas generadas localmente.`);
  };;


