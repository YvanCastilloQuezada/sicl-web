              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Ciudad</p>
                <p className="text-xs font-bold text-[#e2e8f0]">{copilotParams?.ciudad || "—"}</p>
              </div>
              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Estilo</p>
                <p className="text-xs font-bold text-[#e2e8f0]">{copilotParams?.estilo || "—"}</p>
              </div>
            </div>
          </div>

          {/* DERECHA (220px): Copiloto (chat) */}
          <div className="w-[220px] flex-shrink-0 bg-[#0f172a] flex flex-col">
            <div className="p-3 border-b border-[#1e293b] flex items-center justify-between">
              <span className="text-xs font-bold text-[#e2e8f0]">Copiloto</span>
              <Sparkles size={14} className="text-[#f0a35b]"/>
            </div>
            
            <div className="flex-1 overflow-y-auto p-3 space-y-3">
              {messages.map((msg, i) => (
                <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div className={`max-w-[95%] p-2.5 rounded-lg text-[11px] leading-relaxed ${msg.role === 'user' ? 'bg-[#f0a35b] text-black' : 'bg-[#1e293b] text-[#e2e8f0]'}`}>
                    {msg.text}
                  </div>
                </div>
              ))}
              {isGenerating && (
                <div className="flex justify-start">
                  <div className="bg-[#1e293b] p-2.5 rounded-lg flex items-center gap-2 text-[11px]">
                    <Activity className="animate-pulse text-[#f0a35b]" size={14} /> Consultando...
                  </div>
                </div>
              )}
            </div>


          </div>
        </div>
      </div>
      
      {/* INPUT AVANZADO ESTILO CHATGPT CON MENÚ "+" */}
      <div className="fixed bottom-8 left-1/2 transform -translate-x-1/2 w-[700px] max-w-[90vw] z-[1000]">
        {/* Menú desplegable del botón "+" */}
        {showPlusMenu && (
          <div className="absolute bottom-full left-0 mb-2 w-72 bg-[#1e293b] border border-[#334155] rounded-xl shadow-2xl overflow-hidden">
            <div className="p-2 space-y-1">
              <label className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left cursor-pointer">
                <Paperclip size={16} className="text-[#38bdf8]" /> 
                {uploading ? "⏳ Subiendo..." : "📎 Subir planos y archivos (IFC, DWG, PDF)"}
                <input 
                  type="file" 
                  className="hidden" 
                  accept=".ifc,.pdf,.dwg,.rvt,.json,.dxf"
                  onChange={handleFileUpload}
                  disabled={uploading}
                />
              </label>
              <button className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left" onClick={() => { setShowPlusMenu(false); setActiveModal('ifc'); }}>
                <Box size={16} className="text-[#f472b6]" /> Visor 3D / IFC (Renders)
              </button>
              <button 
                className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left"
                onClick={() => {
                  setShowPlusMenu(false);
                  handleNormativaSearch();
                }}
              >
                <Globe size={16} className="text-[#4ade80]" /> 
                {searchingNormativa ? " Buscando..." : "📚 Buscar normativa (RNE, OECE)"}
              </button>
              <button className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left" onClick={() => { setShowPlusMenu(false); setActiveModal('nodes'); }}>
                <Code size={16} className="text-[#fbbf24]" /> Generar código paramétrico
              </button>
              <button className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left" onClick={() => { setShowPlusMenu(false); setActiveModal('editor'); }}>
                <PenTool size={16} className="text-[#a78bfa]" /> Editor de Planos (Canvas)
              </button>
              
              <button className="w-full flex items-center gap-3 px-3 py-2 text-sm text-[#e2e8f0] hover:bg-[#334155] rounded-lg transition text-left" onClick={() => setShowPlusMenu(false)}>
                <Brain size={16} className="text-[#f0a35b]" /> Razonamiento detallado (ARKI Brain)
              </button>
            </div>
          </div>
        )}
        
        <div className="bg-[#1e293b] rounded-2xl border border-[#334155] shadow-2xl focus-within:border-[#f0a35b] transition-all">
          <textarea
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault()
                handleSend()
              }
            }}
            placeholder="Describe lo que quieres construir..."
            disabled={isGenerating}
            className="w-full bg-transparent border-0 rounded-t-2xl px-4 py-3 text-sm text-[#e2e8f0] resize-none focus:outline-none placeholder:text-[#64748b] min-h-[44px]"
            rows={1}
          />
          <div className="flex items-center justify-between px-3 py-2 border-t border-[#334155]">
            <div className="flex items-center gap-2">
              <button 
                onClick={() => setShowPlusMenu(!showPlusMenu)}
                className="p-2 hover:bg-[#334155] rounded-full transition text-[#e2e8f0]"
                title="Más opciones"
              >
                <Plus size={18} />
              </button>
              <button className="p-2 hover:bg-[#334155] rounded-full transition text-[#64748b] hover:text-[#e2e8f0]" title="ARKI Brain">
                <Sparkles size={16} className="text-[#f0a35b]" />
              </button>
            </div>
            <div className="flex items-center gap-2">
              <button 
                onClick={() => {
                  if (isListening) return;
                  startListening((text) => {
                    setInput(text);
                    // Opcional: Auto-enviar después de hablar
                    // setTimeout(() => handleSend(), 500); 
                  });
                }}
                className={`p-2 rounded-full transition ${isListening ? 'bg-red-500/20 text-red-500 animate-pulse' : 'text-[#64748b] hover:text-[#e2e8f0] hover:bg-[#334155]'}`} 
                title={isListening ? "Escuchando..." : "Hablar con ARKI"}
              >
                <Mic size={16} />
              </button>
              <button 
                onClick={handleSend}
                disabled={!input.trim() || isGenerating}
                className="p-2 bg-[#f0a35b] hover:bg-[#e09050] disabled:bg-[#475569] rounded-full transition text-black disabled:text-[#64748b]"
                title="Enviar"
              >
                <Send size={16} />
              </button>
            </div>
          </div>
        </div>
        <p className="text-center text-[9px] text-[#475569] mt-2">ARKI puede cometer errores. Verifica la normativa.</p>
      </div>
    </div>

      {/* MODALES DEL WORKSPACE */}
      {activeModal === 'projects' && <ProjectManagerModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'ifc' && <IFCViewerModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'editor' && <PlanEditorModal onClose={() => setActiveModal(null)} />}


      {activeModal === 'terreno' && (
        <SiteSelectionModal 
          onClose={() => setActiveModal(null)} 
          onSave={(area) => {
            // Aquí actualizamos el área en el panel de la izquierda
            // Asumimos que hay un estado para el área, si no, lo guardamos en un console.log
            console.log("Área del terreno seleccionada:", area);
            // Si tienes un estado para el área del terreno, actualízalo aquí:
            // setAreaTerreno(area);
          }} 
        />
      )}


      {activeModal === 'camera' && <CameraScannerModal onClose={() => setActiveModal(null)} />}


      {activeModal === 'ar' && <ARViewerModal onClose={() => setActiveModal(null)} />}


      {showF1Demo && <F1DemoScreen onClose={() => setShowF1Demo(false)} />}

      {showFullPipeline && <FullPipelineRunner onClose={() => setShowFullPipeline(false)} />}
      {showPipeline && (
        <PipelineDashboardModal 
          onClose={() => setShowPipeline(false)} 
          onNavigate={(phase) => {
            setShowPipeline(false);
            if (phase === 'f1') setShowF1Demo(true);
            if (phase === 'f5') setActiveModal('expediente' as any); // Asumiendo que esto abre el expediente o el modal correcto
            if (phase === 'f6') setActiveModal('analysis');
            if (phase === 'f7') setActiveModal('oece' as any);
            // Puedes mapear el resto de fases a sus respectivos modales aquí
            console.log("Navegando a fase:", phase);
          }} 
        />
      )}

      {showCommandPalette && (
        <CommandPalette 
          onClose={() => setShowCommandPalette(false)} 
          onAction={(action) => setActiveModal(action as any)} 
        />
      )}
      {activeModal === 'nodes' && <NodeEditorModal onClose={() => setActiveModal(null)} />}
      

      {activeModal === 'nodes' && (
        <div className="fixed inset-0 z-[9999] flex flex-col bg-[#0a1825]">
          <div className="flex items-center justify-between p-3 border-b border-[#1e293b] bg-[#0f172a]">
            <h2 className="text-[#e2e8f0] font-bold flex items-center gap-2">
              <Box size={18} className="text-[#f0a35b]" /> Generador Paramétrico Real (DYN / GHX / ARK)
            </h2>
            <button onClick={() => setActiveModal(null)} className="text-[#64748b] hover:text-[#e2e8f0] bg-[#1e293b] p-1 rounded">
              <X size={20} />
            </button>
          </div>
          <div className="flex-1 overflow-y-auto">
            <ArkiParametricRuntimePage />
          </div>
        </div>
      )}
      {/* MODALES NUEVOS */}

      {showWorkspacePanel && (
        <WorkspacePanel 
          onClose={() => setShowWorkspacePanel(false)} 
          onOpenTool={(tool) => {
            if (tool === 'nodes') setActiveModal('nodes');
            if (tool === 'editor') setActiveModal('editor');
            if (tool === 'ar') setActiveModal('ar');
            if (tool === 'analysis') setActiveModal('analysis');
            if (tool === 'camera') setActiveModal('camera');
            if (tool === 'terreno') setActiveModal('terreno');
            if (tool === 'projects') setActiveModal('projects');
            if (tool === 'documents') setActiveModal('documents');
            if (tool === 'render') setActiveModal('ifc');
            if (tool === 'export') setActiveModal('export');
            if (tool === 'templates') setActiveModal('templates');
            if (tool === 'code') setActiveModal('code');
            if (tool === 'norms') setActiveModal('norms');
            if (tool === 'file-chat') setActiveModal('file-chat');
            if (tool === 'expediente') setActiveModal('expediente' as any);
            console.log("[Workspace] Abriendo herramienta:", tool);
          }} 
        />
      )}

      {activeModal === 'code' && <CodeGeneratorModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'export' && <ExportCenterModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'analysis' && <AnalysisDashboardModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'templates' && <TemplatesModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'norms' && <NormativaModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'file-chat' && <FileChatModal onClose={() => setActiveModal(null)} />}

      {/* BOTÓN FLOTANTE DE WORKSPACE */}
      <button 
        onClick={() => setShowWorkspacePanel(true)}
        className="fixed bottom-6 right-6 z-[9000] flex items-center gap-2 px-4 py-3 rounded-full bg-[#38bdf8] text-black font-bold shadow-2xl hover:bg-[#0284c7] transition-all hover:scale-105"
        title="Abrir Workspace (Herramientas)"
      >
        <Layers size={20} /> 
        <span className="text-sm">Workspace</span>
      </button>
</div>
  );
}
