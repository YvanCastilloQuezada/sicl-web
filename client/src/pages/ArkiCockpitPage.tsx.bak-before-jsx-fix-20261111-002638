            <button onMouseEnter={() => handleHover('ejecucion', 'Gestión de la ejecución contractual y personal.')} className={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg transition text-[11px] ${ejecucionOpen ? 'bg-[#f0a35b] text-black font-bold' : 'text-[#e2e8f0] hover:bg-[#1e293b]'}`}>
              <HardHat size={12} className={ejecucionOpen ? 'text-black' : 'text-[#38bdf8]'}/> Ejecución
            </button>
            {ejecucionOpen && (
              <div className="absolute top-full right-0 mt-1 w-max min-w-[220px] bg-[#0f172a] border border-[#1e293b] rounded-lg shadow-2xl z-[9999]">
                <div className="p-2 flex flex-col space-y-1">
                  <button className="w-full text-left px-2 py-1.5 text-[11px] text-[#e2e8f0] hover:bg-[#1e293b] rounded block">Residentes de Obra</button>
                  <button className="w-full text-left px-2 py-1.5 text-[11px] text-[#e2e8f0] hover:bg-[#1e293b] rounded block">Supervisores</button>
                  <button className="w-full text-left px-2 py-1.5 text-[11px] text-[#e2e8f0] hover:bg-[#1e293b] rounded block">Planillas de Personal</button>
                  <button className="w-full text-left px-2 py-1.5 text-[11px] text-[#e2e8f0] hover:bg-[#1e293b] rounded block">Órdenes de Cambio</button>
                  <button className="w-full text-left px-2 py-1.5 text-[11px] text-[#e2e8f0] hover:bg-[#1e293b] rounded block">Órdenes de Servicio</button>
                </div>
              </div>
            )}
          </div>

        </div>

        
        </div>
        <div className="flex-1 flex overflow-hidden w-full relative">


      {/* IZQUIERDA (220px): MENÚ DE FLUJOS */}
      <div className="w-[220px] flex-shrink-0 border-r border-[#1e293b] flex flex-col bg-[#0f172a]">
        <div className="flex items-center gap-2 border-b border-[#1e293b] h-[41px] px-2">
          <div className="w-7 h-7 rounded bg-[#f0a35b] flex items-center justify-center font-bold text-black text-sm">A</div>
          <span className="font-bold tracking-widest text-sm">ARKI <span className="text-[10px] text-[#f0a35b]">v2.0</span></span>
        </div>
        
        <div className="p-3 flex-1 space-y-1">
          <p className="text-[10px] font-bold text-[#64748b] uppercase tracking-wider mb-3">DATOS</p>
          {/* Aquí irán los datos del proyecto (área, pisos, etc.) */}
          <div className="space-y-2">
            <div className="bg-[#1e293b] p-2 rounded-lg">
              <p className="text-[9px] text-[#64748b]">Área</p>
              <p className="text-xs font-bold text-[#38bdf8]">{copilotParams?.area_m2 || "—"} m²</p>
            </div>
            <div className="bg-[#1e293b] p-2 rounded-lg">
              <p className="text-[9px] text-[#64748b]">Pisos</p>
              <p className="text-xs font-bold text-[#f0a35b]">{copilotParams?.pisos || "—"}</p>
            </div>
            <div className="bg-[#1e293b] p-2 rounded-lg">
              <p className="text-[9px] text-[#64748b]">Ciudad</p>
              <p className="text-xs font-bold text-[#e2e8f0]">{copilotParams?.ciudad || "—"}</p>
            </div>
          </div>
        </div>

        <div className="p-3 border-t border-[#1e293b] text-[10px] text-[#64748b]">
          <p>GPU: RTX 3060 ({gpuUsage !== null ? `${gpuUsage}%` : "—"})</p>
          <p>Core: SICL v1.2</p>
        </div>
      </div>

      {/* CONTENEDOR PRINCIPAL: MENÚ HORIZONTAL + CONTENIDO */}
      <div className="flex-1 flex flex-col overflow-hidden">

        {/* CONTENIDO: CENTRO + NUEVA BARRA + DERECHA */}
        <div className="flex-1 flex overflow-visible relative z-0">

          {/* CENTRO (flex-1): Funnel 16-4-1 */}
          <div className="flex-1 flex flex-col overflow-hidden border-r border-[#1e293b] bg-[#0a0f16]">
            
            <div className="flex-1 overflow-auto p-4">
              <ProposalGallery proposals={partis} />
            </div>
          </div>

          {/* NUEVA BARRA (220px): Correcciones / Paramétricas */}
          <div className="w-[220px] flex-shrink-0 border-r border-[#1e293b] bg-[#0f172a] flex flex-col">
            <div className="p-3 border-b border-[#1e293b] flex items-center justify-between">
              <span className="text-xs font-bold text-[#e2e8f0]">Correcciones</span>
              <Sparkles size={14} className="text-[#f0a35b]"/>
            </div>
            <div className="flex-1 overflow-y-auto p-3 space-y-2">
              <p className="text-[10px] text-[#64748b]">Panel de correcciones paramétricas.</p>
              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Área</p>
                <p className="text-xs font-bold text-[#38bdf8]">{copilotParams?.area_m2 || "—"} m²</p>
              </div>
              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Pisos</p>
                <p className="text-xs font-bold text-[#f0a35b]">{copilotParams?.pisos || "—"}</p>
              </div>
              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Ciudad</p>
                <p className="text-xs font-bold text-[#e2e8f0]">{copilotParams?.ciudad || "—"}</p>
              </div>
              <div className="bg-[#1e293b] p-2 rounded-lg">
                <p className="text-[9px] text-[#64748b]">Estilo</p>
                <p className="text-xs font-bold text-[#e2e8f0]">{copilotParams?.estilo || "—"}</p>
              </div>
            </div>
          </div>

          {/* DERECHA (220px): Copiloto (chat) */}
          <div className="w-[220px] flex-shrink-0 bg-[#0f172a] flex flex-col">
            <div className="p-3 border-b border-[#1e293b] flex items-center justify-between">
              <span className="text-xs font-bold text-[#e2e8f0]">Copiloto</span>
              <Sparkles size={14} className="text-[#f0a35b]"/>
            </div>
            
            <div className="flex-1 overflow-y-auto p-3 space-y-3">
              {messages.map((msg, i) => (
                <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div className={`max-w-[95%] p-2.5 rounded-lg text-[11px] leading-relaxed ${msg.role === 'user' ? 'bg-[#f0a35b] text-black' : 'bg-[#1e293b] text-[#e2e8f0]'}`}>
                    {msg.text}
                  </div>
                </div>
              ))}
              {isGenerating && (
                <div className="flex justify-start">
                  <div className="bg-[#1e293b] p-2.5 rounded-lg flex items-center gap-2 text-[11px]">
                    <Activity className="animate-pulse text-[#f0a35b]" size={14} /> Consultando...
                  </div>
                </div>
              )}
            </div>


          </div>
        </div>
      </div>
      
      {/* CHAT REFACTORIZADO */}
      <div className="fixed bottom-8 left-1/2 transform -translate-x-1/2 w-[700px] max-w-[90vw] z-[1000]">
        <CopilotPanel
          messages={messages}
          input={input}
          setInput={setInput}
          onSend={handleSend}
          isGenerating={isGenerating}
          onOpenAction={(action) => {
            if (action === "norms") setActiveModal("norms");
            if (action === "projects") setActiveModal("projects");
            if (action === "terreno") setActiveModal("terreno");
            if (action === "documents") setActiveModal("documents");
            if (action === "camera") setActiveModal("camera");
            if (action === "analysis") setActiveModal("analysis");
            if (action === "ifc") setActiveModal("ifc");
            if (action === "export") setActiveModal("export");
            if (action === "templates") setActiveModal("templates");
            if (action === "code") setActiveModal("code");
            if (action === "file-chat") setActiveModal("file-chat");
          }}
          onOpenWorkspace={() => setShowWorkspacePanel(true)}
        />
      </div>
      {activeModal === 'ifc' && <IFCViewerModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'editor' && <PlanEditorModal onClose={() => setActiveModal(null)} />}


      {activeModal === 'terreno' && (
        <SiteSelectionModal 
          onClose={() => setActiveModal(null)} 
          onSave={(area) => {
            // Aquí actualizamos el área en el panel de la izquierda
            // Asumimos que hay un estado para el área, si no, lo guardamos en un console.log
            console.log("Área del terreno seleccionada:", area);
            // Si tienes un estado para el área del terreno, actualízalo aquí:
            // setAreaTerreno(area);
          }} 
        />
      )}


      {activeModal === 'camera' && <CameraScannerModal onClose={() => setActiveModal(null)} />}


      {activeModal === 'ar' && <ARViewerModal onClose={() => setActiveModal(null)} />}


      {showF1Demo && <F1DemoScreen onClose={() => setShowF1Demo(false)} />}

      {showFullPipeline && <FullPipelineRunner onClose={() => setShowFullPipeline(false)} />}
      {showPipeline && (
        <PipelineDashboardModal 
          onClose={() => setShowPipeline(false)} 
          onNavigate={(phase) => {
            setShowPipeline(false);
            if (phase === 'f1') setShowF1Demo(true);
            if (phase === 'f5') setActiveModal('expediente' as any); // Asumiendo que esto abre el expediente o el modal correcto
            if (phase === 'f6') setActiveModal('analysis');
            if (phase === 'f7') setActiveModal('oece' as any);
            // Puedes mapear el resto de fases a sus respectivos modales aquí
            console.log("Navegando a fase:", phase);
          }} 
        />
      )}

      {showCommandPalette && (
        <CommandPalette 
          onClose={() => setShowCommandPalette(false)} 
          onAction={(action) => setActiveModal(action as any)} 
        />
      )}
      {activeModal === 'nodes' && <NodeEditorModal onClose={() => setActiveModal(null)} />}
      

      {activeModal === 'nodes' && (
        <div className="fixed inset-0 z-[9999] flex flex-col bg-[#0a1825]">
          <div className="flex items-center justify-between p-3 border-b border-[#1e293b] bg-[#0f172a]">
            <h2 className="text-[#e2e8f0] font-bold flex items-center gap-2">
              <Box size={18} className="text-[#f0a35b]" /> Generador Paramétrico Real (DYN / GHX / ARK)
            </h2>
            <button onClick={() => setActiveModal(null)} className="text-[#64748b] hover:text-[#e2e8f0] bg-[#1e293b] p-1 rounded">
              <X size={20} />
            </button>
          </div>
          <div className="flex-1 overflow-y-auto">
            <ArkiParametricRuntimePage />
          </div>
        </div>
      )}
      {/* MODALES NUEVOS */}

      {showWorkspacePanel && (
        <WorkspacePanel 
          onClose={() => setShowWorkspacePanel(false)} 
          onOpenTool={(tool) => {
            // Mapeamos las herramientas del Workspace a los modales existentes
            if (tool === 'nodes') setActiveModal('nodes');
            if (tool === 'editor') setActiveModal('editor');
            if (tool === 'ar') setActiveModal('ar');
            if (tool === 'analysis') setActiveModal('analysis');
            if (tool === 'camera') setActiveModal('camera');
            if (tool === 'terreno') setActiveModal('terreno');
            if (tool === 'projects') setActiveModal('projects');
            if (tool === 'documents') setActiveModal('documents');
            console.log("Abriendo herramienta:", tool);
          }} 
        />
      )}

      {activeModal === 'code' && <CodeGeneratorModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'export' && <ExportCenterModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'analysis' && <AnalysisDashboardModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'templates' && <TemplatesModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'norms' && <NormativaModal onClose={() => setActiveModal(null)} />}
      {activeModal === 'file-chat' && <FileChatModal onClose={() => setActiveModal(null)} />}

      {/* BOTÓN FLOTANTE DE WORKSPACE */}
      <button 
        onClick={() => setShowWorkspacePanel(true)}
        className="fixed bottom-6 right-6 z-[9000] flex items-center gap-2 px-4 py-3 rounded-full bg-[#38bdf8] text-black font-bold shadow-2xl hover:bg-[#0284c7] transition-all hover:scale-105"
        title="Abrir Workspace (Herramientas)"
      >
        <Layers size={20} /> 
        <span className="text-sm">Workspace</span>
      </button>
</div>
  );
}
