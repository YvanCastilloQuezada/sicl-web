{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arki.local/contracts/s10-normalized-1.0.schema.json",
  "title": "ARKI S10 Normalized Project 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "projectId", "sourceId", "sourceFormat", "sourceChecksum", "effectiveDate", "currency", "items", "evidenceState", "unknowns"],
  "properties": {
    "schema": { "const": "ARKI-S10-NORMALIZED-1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "sourceFormat": { "enum": ["STRUCTURED_EXPORT", "EXCEL_EXPORT", "REPORT_EXTRACTION"] },
    "sourceChecksum": { "type": "string", "minLength": 1 },
    "effectiveDate": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "evidenceState": { "enum": ["VERIFIED_STRUCTURE", "PARTIAL", "UNKNOWN"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemId", "code", "description", "unit", "quantity", "unitPrice", "sourceRef"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 }, "code": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }, "unit": { "type": "string" },
          "quantity": { "type": "number", "minimum": 0 }, "unitPrice": { "type": "number", "minimum": 0 },
          "sourceRef": { "type": "string", "minLength": 1 }, "apuRef": { "type": "string" }
        }
      }
    },
    "resources": { "type": "array" },
    "apus": { "type": "array" },
    "budgetNodes": { "type": "array" },
    "declaredTotals": { "type": "object" }
  }
}
