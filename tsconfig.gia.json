  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo.gia"
  },
  "include": [
    "server/arkiGia.test.ts",
